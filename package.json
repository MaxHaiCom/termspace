{
  "name": "termspace",
  "version": "0.4.3",
  "description": "无限画布终端管理器 — terminals as nodes on an infinite canvas",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false PATH=\"$PWD/scripts/codesign-retry:$PATH\" electron-builder --mac --arm64 --x64 --config electron-builder.yml",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "dist:signed": "electron-vite build && PATH=\"$PWD/scripts/codesign-retry:$PATH\" electron-builder --mac --arm64 --x64 --config electron-builder.yml",
    "dist:local": "electron-vite build && PATH=\"$PWD/scripts/codesign-retry:$PATH\" electron-builder --mac --arm64 --config electron-builder.yml -c.mac.notarize=false && npm run rebuild",
    "lint": "oxlint src test mobile",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "oxlint": "^1.76.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
